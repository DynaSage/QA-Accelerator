# Azure OpenAI (GPT-5.1)
AZURE_OPENAI_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_DEPLOYMENT=gpt-5.1
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_MODEL=gpt-5.1

# Azure Databricks SQL Warehouse
DATABRICKS_SERVER_HOSTNAME=adb-xxxx.xx.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id
DATABRICKS_ACCESS_TOKEN=your-databricks-token
DATABRICKS_CATALOG=main
DATABRICKS_SOURCE_SCHEMA=stg
DATABRICKS_TARGET_SCHEMA=dw
DATABRICKS_QUERY_TIMEOUT_SECONDS=120
DATABRICKS_PREVIEW_ROWS=20

# Azure DevOps (User Story import)
AZURE_DEVOPS_ORG=your-organization-name
AZURE_DEVOPS_PROJECT=your-project-name
AZURE_DEVOPS_PAT=your-personal-access-token
# Optional filters
AZURE_DEVOPS_AREA_PATH=
AZURE_DEVOPS_ITERATION_PATH=
AZURE_DEVOPS_WORK_ITEM_IDS=
AZURE_DEVOPS_WORK_ITEM_TYPES=User Story
AZURE_DEVOPS_MAX_STORIES=25
AZURE_DEVOPS_TIMEOUT_SECONDS=60

# Optional Fabric / Data Nexus column metadata (JSON)
# FABRIC_METADATA_PATH=samples/metadata/fabric_columns.json
